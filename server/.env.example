# Server Environment Variables
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/reconcile_ai

# Anthropic Claude API Configuration
CLAUDE_API_KEY=your_anthropic_claude_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Security & Authentication
JWT_SECRET=your_jwt_secret_min_32_characters_long_for_security_reasons
JWT_EXPIRES_IN=7d

# Mail Sandbox (Mailtrap / Local stub)
MAIL_SANDBOX_HOST=sandbox.smtp.mailtrap.io
MAIL_SANDBOX_PORT=2525
MAIL_SANDBOX_USER=your_mailtrap_user_placeholder
MAIL_SANDBOX_PASS=your_mailtrap_password_placeholder
