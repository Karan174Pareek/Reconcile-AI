# ==============================================================================
# ReconcileAI Environment Configuration Template
# Copy this file to `server/.env` (and root `.env` if desired) and fill in your values.
# NEVER COMMIT REAL API KEYS, PASSWORDS, OR SECRETS TO VERSION CONTROL.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas or local instance)
MONGO_URI=mongodb://localhost:27017/reconcile_ai

# Anthropic Claude API Configuration
# Used for Pass 3 exception reasoning, Agent Chat tool use, and Draft Action synthesis
CLAUDE_API_KEY=your_anthropic_claude_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Security & Authentication
JWT_SECRET=your_jwt_secret_min_32_characters_long_for_security_reasons
JWT_EXPIRES_IN=7d

# Sandbox Mail Relay (Mailtrap / local stub for demo draft execution)
# Note: In demo scope, emails are only routed to sandbox/stubs, never real SMTP relays.
MAIL_SANDBOX_HOST=sandbox.smtp.mailtrap.io
MAIL_SANDBOX_PORT=2525
MAIL_SANDBOX_USER=your_mailtrap_user_placeholder
MAIL_SANDBOX_PASS=your_mailtrap_password_placeholder
