{
  "name": "reconcile-ai-server",
  "version": "1.0.0",
  "description": "Backend API, matching pipeline and Claude agent orchestrator for ReconcileAI",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/generateSeed.js --mongo",
    "seed:csv": "node scripts/generateSeed.js --csv",
    "seed:all": "node scripts/generateSeed.js --mongo --csv",
    "build": "node build.js",
    "bench": "node scripts/runBenchmark.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
