# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB local or Atlas URI)
MONGO_URI=mongodb://localhost:27017/reconcile_ai

# Anthropic Claude API Configuration (used for Pass 3 AI reasoning and Agent Chat)
# Supports both ANTHROPIC_API_KEY and CLAUDE_API_KEY
ANTHROPIC_API_KEY=your_anthropic_claude_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Security & Authentication (JWT Bearer Token signing secret)
JWT_SECRET=your_jwt_secret_min_32_characters_long_for_security_reasons
JWT_EXPIRES_IN=7d

# Mail Sandbox Configuration (for testing HITL vendor email dispatches)
MAIL_SANDBOX_HOST=sandbox.smtp.mailtrap.io
MAIL_SANDBOX_PORT=2525
MAIL_SANDBOX_USER=your_mailtrap_user_placeholder
MAIL_SANDBOX_PASS=your_mailtrap_password_placeholder
