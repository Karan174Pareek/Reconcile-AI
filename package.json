{
  "name": "reconcile-ai",
  "version": "1.0.0",
  "description": "AI-powered bank & ledger reconciliation engine with Claude exception reasoning",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "install:all": "npm install --prefix server && npm install --prefix client",
    "seed": "npm run seed --prefix server",
    "seed:csv": "node server/scripts/generateSeed.js --csv",
    "seed:mongo": "node server/scripts/generateSeed.js --mongo",
    "start": "npm run start --prefix server",
    "bench": "node server/scripts/runBenchmark.js",
    "test:coverage": "npm run test:coverage --prefix server",
    "build": "node scripts/syncServer.js && npm run build --prefix client",
    "build:client": "node scripts/syncServer.js && npm run build --prefix client"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "papaparse": "^5.5.1",
    "socket.io": "^4.8.1",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "playwright": "^1.62.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Karan",
  "license": "UNLICENSED"
}
